import slices

struct SliceIter<T any> {
  mut slice Slice<T>;
  mut current int;
}

impl SliceIter<T any> {
  fn next(&self) bool {
    self.current = self.current + 1
    return self.current < self.slice._len
  }

  fn index(&self) int {
    return self.current
  }

  fn value(&self) T {
    let x T
    let item_size int = sizeof(x)
    let target *T = self.slice.ptr + (self.current * item_size)
    return *target
  }

  fn entry(self) (int, T) {
    return (self.index(), self.value())
  }
}

pub struct Slice<T any> {
  mut ptr *T;
  mut _len int;
  mut cap int;
}

impl Slice<T any> {
  pub fn new(cap int) Slice<T> {
    let s Slice<T> = Slice<T>{ptr = malloc<T>(cap); _len = cap; cap = cap}
    return s
  }

  pub fn len(&self) uint {
    return self._len
  }

  pub fn get(self, index int) !T {
    assert(self._len > index, "unbound index")

    let start *T = self.ptr
    let search *T = self.ptr + (index * sizeof(*start))
    return *search
  }

  pub fn set(&self, index int, v T) void {
    assert(index >= 0, "index out of bounds")
    assert(self._len > index, "index out of bounds")

    let item_size int = sizeof(v)
    let target *T = self.ptr + (index * item_size)
    *target = v
  }

  fn _append(&self, item T) void {
    let so int = sizeof(item)

    if self._len >= self.cap {
      let new_cap int = if self.cap == 0 { 4 } else { self.cap * 2 }
      
      self.ptr = realloc<T>(self.ptr, new_cap)
      self.cap = new_cap
    }

    let target *T = self.ptr + (self._len * so)
    *target = item
    
    self._len = self._len + 1
  }

  pub fn append(&self, items ...T) void {
    let iter = items.iter()
    for iter.next() {
      self._append(iter.value())
    }
  }

  pub fn clone(self) Slice<T> {
    let mut new_slice = Slice.new<T>(self.cap)
    new_slice._len = self._len

    for i = 0; i < self._len; i = i + 1 {
      new_slice.set(i, self.get(i))
    }

    return new_slice
  }

  pub fn concat(self, y Slice<T>) Slice<T> {
    let mut new_slice = Slice.new<T>(self._len + y._len)
    for i = 0; i < self._len; i = i + 1 {
      new_slice.set(i, self.get(i))
    }
    for i = 0; i < y._len; i = i + 1 {
      new_slice.set(i + self._len, y.get(i))
    }
    return new_slice
  }

  pub fn contains(self, v T) bool {
    for i = 0; i < self._len; i = i + 1 {
      let current_ptr = self.get(i)
      if current_ptr == v {
        return true
      }
    }

    return false
  }

  pub fn delete(&self, start int, end int) Slice<T> {
    if start < 0 || end > self._len || start >= end {
      return self
    }

    let x T
    let item_size int = sizeof(x)
    let num_to_delete = end - start
    let num_to_move int = self._len - end

    for i = 0; i < num_to_move; i = i + 1 {
      let target_ptr *T = self.ptr + ((start + i) * item_size)
      let source_ptr *T = self.ptr + ((end + i) * item_size)
      *target_ptr = *source_ptr
    }
    self._len = self._len - num_to_delete

    return self
  }

  pub fn iter(self) SliceIter<T> {
    return SliceIter<T>{
      slice = self;
      current = -1
    }
  }

  pub fn write(&self, p Slice<T>) !int {
    let plen = p.len()
    for i = 0; i < plen; i = i + 1 {
      self._append(p.get(i))
    }

    return p.len()
  }

}

