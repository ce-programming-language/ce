import slices
import net.url

type size_t uint
type socklen_t uint

struct SockAddrIn {
  mut sin_family i16;
  mut sin_port u16;
  mut sin_addr u32;
  mut sin_zero [8]i8;
}

extern "socket" fn c_socket(domain int, type_ int, protocol int) int
extern "bind" fn c_bind(sockfd int, addr *SockAddrIn, addrlen socklen_t) int
extern "listen" fn c_listen(sockfd int, backlog int) int
extern "accept" fn c_accept(sockfd int, addr *SockAddrIn, addrlen *socklen_t) int
extern "close" fn c_close(fd int) int
extern "send" fn c_send(sockfd int, buf string, len size_t, flags int) int
extern "recv" fn c_recv(sockfd int, buf *char, len size_t, flags int) int
extern "htons" fn c_htons(hostshort u16) u16
extern "inet_addr" fn c_inet_addr(cp string) u32

struct Listener {
  mut network string;
  mut address string;
  mut addr SockAddrIn;

  mut server_fd int;
  mut server_addr_len socklen_t;
  mut client_addr_len socklen_t;
}

struct Connection {
  mut client_fd int;
}

impl Listener {
  fn accept(&self) !*Connection {
    let dummy Connection
    let conn *Connection = malloc(sizeof(dummy))
    let client_fd = c_accept(self.server_fd, &self.addr, &self.client_addr_len)
    if client_fd < 0 {
      raise ("Error: Failed to accept client")
    }

    conn.client_fd = client_fd
    return conn
  }

  fn close(&self) !void {
    c_close(self.server_fd)
  }
}

impl Connection {
  fn send(&self, msg string) !void {
    let msg_len size_t = msg.len()
    let bytes_sent = c_send(self.client_fd, msg, msg_len, 0)
    if bytes_sent < 0 {
      raise ("Error: Failed to send message")
    }
  }

  fn close(&self) !void {
    c_close(self.client_fd)
  }

  fn write(&self, p slices.Slice<char>) !int {
    let p_len size_t = p.len
    let msg string = p.ptr 
    let bytes_written = c_send(self.client_fd, msg, p_len, 0)

    if bytes_written < 0 {
      raise ("Error: Failed to write to socket")
    }
    return bytes_written
  }

  fn read(&self, buf slices.Slice<char>) !int {
    let buf_len size_t = buf.len 
    let bytes_read = c_recv(self.client_fd, buf.ptr, buf_len, 0)
    
    if bytes_read < 0 {
      raise ("Error: Failed to read from socket")
    }
    return bytes_read
  }
}

fn listen(network string, address string) !*Listener {
  let u = url.parse(address)
  let dummy Listener
  let l *Listener = malloc(sizeof(dummy))
  l.network = network
  l.address = address

  let AF_INET int = 2
  let SOCK_STREAM int = 1
  let INADDR_ANY u32 = 0
  
  l.server_fd = c_socket(AF_INET, SOCK_STREAM, 0)
  if l.server_fd < 0 {
    raise ("Error: Failed to create socket")
  }

  let port_s string = u.port
  let port = port_s.as<u16>()
  l.addr = SockAddrIn {
    sin_family = AF_INET;
    sin_port = c_htons(port);
    sin_addr = c_inet_addr(u.host);
    sin_zero = [8]i8{0, 0, 0, 0, 0, 0, 0, 0}
  }
  l.server_addr_len = 16

  let bind_res = c_bind(l.server_fd, &l.addr, l.server_addr_len)
  if bind_res < 0 {
    raise ("Error: Failed to bind to that port")
  }

  let listen_res = c_listen(l.server_fd, 3)
  if listen_res < 0 {
    raise ("Error: Failed to listen")
  }

  return l
}

