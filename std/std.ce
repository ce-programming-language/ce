pub trait any{}

type size_t u64

extern "unsafe_typeof" fn unsafe_typeof(val *any) string
extern "unsafe_sizeof" fn unsafe_sizeof(val *any) size_t
extern "unsafe_malloc" fn unsafe_malloc(size size_t) *void
extern "unsafe_realloc" fn unsafe_realloc(ptr *void, size size_t) *void

pub trait Iterable {
  fn next() bool;
}

pub fn assert(condition bool, message string) !void {
  if condition { return }

  if message == "" {
    raise "Assertion failed!"
  }

  raise message
}

pub fn typeof(val any) string {
  return unsafe_typeof(&val)
}

pub fn sizeof(val any) size_t {
  return unsafe_sizeof(&val)
}

pub fn malloc<T any>(s size_t) *T {
  return unsafe_malloc(s)
}

pub fn realloc<T any>(dst *T, s size_t) *T {
  return unsafe_realloc(dst, s)
}

impl string {
  pub fn len(self) uint {
    let mut count uint = 0
    let null_char char = 0

    let mut ptr *char = self
    for {
      if *ptr == null_char {
        break
      }

      count = count + 1
      ptr = ptr + 1
    }

    return count
  }
}
