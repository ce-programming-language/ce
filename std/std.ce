pub trait any{}

pub trait Iterable {
  fn next() bool;
}

pub fn assert(condition bool, message string) !void {
  if condition { return }

  if message == "" {
    raise "Assertion failed!"
  }

  raise message
}

pub fn typeof(x any) string {
  return "unknown"
}

pub fn malloc<T any>(size uint) *T {
  let dummy T
  return &dummy
}

pub fn realloc<T any>(ptr *T, new_size uint) *T {
  let dummy T
  return &dummy
}

impl int {
  pub fn size(self) uint { return 4 }
  pub fn min(self) int { return -2147483648 }
  pub fn max(self) int { return 2147483647 }
}

impl i8 {
  pub fn size(self) uint { return 1 }
  pub fn min(self) i8 { return -128 }
  pub fn max(self) i8 { return 127 }
}

impl i16 {
  pub fn size(self) uint { return 2 }
  pub fn min(self) i16 { return -32768 }
  pub fn max(self) i16 { return 32767 }
}

impl i64 {
  pub fn size(self) uint { return 8 }
  pub fn max(self) i64 { 
    let zero u64 = 0
    let one u64 = 1
    let two u64 = 2
    let umax u64 = zero - one
    return umax / two
  }
  
  pub fn min(self) i64 { 
    let zero i64 = 0
    let one i64 = 1
    let zero_u u64 = 0
    let one_u u64 = 1
    let two_u u64 = 2
    let max_i i64 = (zero_u - one_u) / two_u
    return zero - max_i - one
  }
}

impl i128 {
  pub fn size(self) uint { return 16 }
  pub fn max(self) i128 { 
    let zero u128 = 0
    let one u128 = 1
    let two u128 = 2
    let umax u128 = zero - one
    return umax / two
  }
  
  pub fn min(self) i128 { 
    let zero i128 = 0
    let one i128 = 1
    let zero_u u128 = 0
    let one_u u128 = 1
    let two_u u128 = 2
    let max_i i128 = (zero_u - one_u) / two_u
    return zero - max_i - one
  }
}

impl uint {
  pub fn size(self) uint { return 4 }
  pub fn min(self) uint { return 0 }
  pub fn max(self) uint { return 4294967295 }
}

impl u8 {
  pub fn size(self) uint { return 1 }
  pub fn min(self) u8 { return 0 }
  pub fn max(self) u8 { return 255 }
}

impl u16 {
  pub fn size(self) uint { return 2 }
  pub fn min(self) u16 { return 0 }
  pub fn max(self) u16 { return 65535 }
}

impl u64 {
  pub fn size(self) uint { return 8 }
  pub fn min(self) u64 { return 0 }
  pub fn max(self) u64 { 
    let zero u64 = 0
    let one u64 = 1
    return zero - one
  }
}

impl u128 {
  pub fn size(self) uint { return 16 }
  pub fn min(self) u128 { return 0 }
  pub fn max(self) u128 { 
    let zero u128 = 0
    let one u128 = 1
    return zero - one 
  }
}

impl f32 {
  pub fn size(self) uint { return 4 }
  pub fn min(self) f32 { return -340282346638528859811704183484516925440.0 }
  pub fn max(self) f32 { return 340282346638528859811704183484516925440.0 }
}

impl float {
  pub fn size(self) uint { return 8 }
  pub fn min(self) float { return -.0 }
  pub fn max(self) float { return .0 }
}

impl string {
  pub fn len(self) uint {
    let mut count uint = 0
    let null_char char = 0

    let mut ptr *char = self
    for {
      if *ptr == null_char {
        break
      }

      count = count + 1
      ptr = ptr + 1
    }

    return count
  }
}
